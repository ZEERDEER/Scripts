#!name = RevenueCat 抓取
#!desc = 抓取 RevenueCat 产品与权益信息：产品 ID、权益名、套餐、订阅状态，弹通知显示
#!author = Torque
#!homepage = https://github.com/ZEERDEER/Scripts
#!icon = https://www.revenuecat.com/icons/icon-512x512.png
#!date = 2026-11-24 00:00:00

[Script]
http-response https:\/\/api\.revenuecat\.com\/v1\/(product_entitlement_mapping|subscribers\/.+\/(offerings|products)|subscribers(\/[^\/]+)?$|receipts) script-path=https://raw.githubusercontent.com/ZEERDEER/Scripts/main/js/revenuecatcatcher.js, requires-body=true, timeout=60, tag=RC抓取
http-response https:\/\/api\.rc-backup\.com\/v1\/(product_entitlement_mapping|subscribers\/.+\/(offerings|products)|subscribers(\/[^\/]+)?$|receipts) script-path=https://raw.githubusercontent.com/ZEERDEER/Scripts/main/js/revenuecatcatcher.js, requires-body=true, timeout=60, tag=RC抓取
http-request https:\/\/api\.revenuecat\.com\/v1\/(product_entitlement_mapping|subscribers\/.+\/(offerings|products)|subscribers(\/[^\/]+)?$|receipts) script-path=https://raw.githubusercontent.com/ZEERDEER/Scripts/main/js/revenuecatcatcher.js, timeout=60, tag=RC抓取
http-request https:\/\/api\.rc-backup\.com\/v1\/(product_entitlement_mapping|subscribers\/.+\/(offerings|products)|subscribers(\/[^\/]+)?$|receipts) script-path=https://raw.githubusercontent.com/ZEERDEER/Scripts/main/js/revenuecatcatcher.js, timeout=60, tag=RC抓取

[Mitm]
hostname = api.revenuecat.com, api.rc-backup.com
