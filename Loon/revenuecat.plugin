#!name = RevenueCat 解锁
#!desc = 恢复订阅模板：填入权益名与产品 ID，解锁 RevenueCat 会员。先用 RevenueCat 抓取插件抓到两个值，再填到这里。
#!author = Torque
#!homepage = https://github.com/ZEERDEER/Scripts
#!icon = https://www.revenuecat.com/icons/icon-512x512.png
#!input = name
#!input = appid
#!date = 2026-11-24 00:00:00

[Script]
http-response ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/ZEERDEER/Scripts/main/js/revenuecat.js, requires-body=true, timeout=60, tag=RC解锁
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/ZEERDEER/Scripts/main/js/revenuecat.js, timeout=60, tag=RC解锁
http-response ^https?:\/\/api\.rc-backup\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/ZEERDEER/Scripts/main/js/revenuecat.js, requires-body=true, timeout=60, tag=RC解锁
http-request ^https?:\/\/api\.rc-backup\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/ZEERDEER/Scripts/main/js/revenuecat.js, timeout=60, tag=RC解锁

[Mitm]
hostname = api.revenuecat.com, api.rc-backup.com
